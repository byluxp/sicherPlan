POSTGRES_DB=sicherplan
POSTGRES_USER=sicherplan
POSTGRES_PASSWORD=sicherplan
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg2://sicherplan:sicherplan@localhost:5433/sicherplan

# Leitura de documentos com IA (opcional). Sem chave, é usado o OCR local (Tesseract).
# Use chave de projeto com faturamento ativo: no nível gratuito o Google pode usar os dados enviados.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Popula o banco vazio com dados fictícios de teste ao iniciar o backend (true/false)
SEED_DADOS_TESTE=false
