        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n  class Colaborador {\n    +Integer id\n    +String nome\n    +String cpf\n    +Date data_nascimento\n    +Date data_admissao\n    +Date data_demissao\n    +Integer setor_id\n    +Integer funcao_id\n    +Boolean ativo\n    +DateTime criado_em\n    +DateTime atualizado_em\n  }\n\n  class Setor {\n    +Integer id\n    +String nome\n    +String descricao\n    +Boolean ativo\n    +DateTime criado_em\n    +DateTime atualizado_em\n  }\n\n  class Funcao {\n    +Integer id\n    +String nome\n    +Integer setor_id\n    +String descricao\n    +Boolean ativo\n    +DateTime criado_em\n    +DateTime atualizado_em\n  }\n\n  class Epi {\n    +Integer id\n    +String nome\n    +String grupo_protecao\n    +String ca_numero\n    +Date data_validade_ca\n    +Integer durabilidade_dias\n    +String url_pdf_ca\n    +Boolean ativo\n    +DateTime criado_em\n    +DateTime atualizado_em\n  }\n\n  class FuncaoEpiObrigatorio {\n    +Integer id\n    +Integer funcao_id\n    +Integer epi_id\n    +DateTime criado_em\n  }\n\n  class HistoricoFuncao {\n    +Integer id\n    +Integer colaborador_id\n    +Integer funcao_id\n    +Integer setor_id\n    +Date data_inicio\n    +Date data_fim\n    +String motivo_mudanca\n    +DateTime criado_em\n  }\n\n  class EntregaEpi {\n    +Integer id\n    +Integer colaborador_id\n    +Integer epi_id\n    +Integer quantidade\n    +Date data_entrega\n    +Boolean assinado\n    +String observacao\n    +DateTime criado_em\n    +DateTime atualizado_em\n  }\n\n  class Aso {\n    +Integer id\n    +Integer colaborador_id\n    +String tipo\n    +Date data_emissao\n    +Date data_vencimento\n    +String url_documento\n    +String observacao\n    +DateTime criado_em\n    +DateTime atualizado_em\n  }\n\n  class Certificado {\n    +Integer id\n    +String nome\n    +String nr_codigo\n    +Integer carga_horaria\n    +Integer validade_meses\n    +String descricao\n    +DateTime criado_em\n  }\n\n  class ColaboradorCertificado {\n    +Integer id\n    +Integer colaborador_id\n    +Integer certificado_id\n    +Date data_conclusao\n    +Date data_vencimento\n    +String url_certificado\n    +DateTime criado_em\n  }\n\n  class OrdemServico {\n    +Integer id\n    +Integer colaborador_id\n    +String titulo\n    +Date data_emissao\n    +Boolean assinado\n    +String url_documento\n    +DateTime criado_em\n  }\n\n  class FichaRegistro {\n    +Integer id\n    +Integer colaborador_id\n    +String tipo_documento\n    +String url_documento\n    +Boolean validado\n    +Date data_emissao\n    +Date data_vencimento\n    +DateTime criado_em\n  }\n\n  Setor \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Colaborador : possui\n  Setor \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Funcao : possui\n  Setor \&quot;1\&quot; --&gt; \&quot;0..*\&quot; HistoricoFuncao : registra\n\n  Funcao \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Colaborador : exerce\n  Funcao \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FuncaoEpiObrigatorio : exige\n  Funcao \&quot;1\&quot; --&gt; \&quot;0..*\&quot; HistoricoFuncao : registra\n\n  Epi \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FuncaoEpiObrigatorio : obrigatorio_para\n  Epi \&quot;1\&quot; --&gt; \&quot;0..*\&quot; EntregaEpi : entregue_em\n\n  Colaborador \&quot;1\&quot; --&gt; \&quot;0..*\&quot; HistoricoFuncao : possui\n  Colaborador \&quot;1\&quot; --&gt; \&quot;0..*\&quot; EntregaEpi : recebe\n  Colaborador \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Aso : possui\n  Colaborador \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ColaboradorCertificado : conclui\n  Colaborador \&quot;1\&quot; --&gt; \&quot;0..*\&quot; OrdemServico : possui\n  Colaborador \&quot;1\&quot; --&gt; \&quot;0..*\&quot; FichaRegistro : possui\n\n  Certificado \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ColaboradorCertificado : associado_a\n\n  FuncaoEpiObrigatorio \&quot;*\&quot; --&gt; \&quot;1\&quot; Funcao : funcao\n  FuncaoEpiObrigatorio \&quot;*\&quot; --&gt; \&quot;1\&quot; Epi : epi\n  HistoricoFuncao \&quot;*\&quot; --&gt; \&quot;1\&quot; Colaborador : colaborador\n  HistoricoFuncao \&quot;*\&quot; --&gt; \&quot;1\&quot; Funcao : funcao\n  HistoricoFuncao \&quot;*\&quot; --&gt; \&quot;1\&quot; Setor : setor\n  EntregaEpi \&quot;*\&quot; --&gt; \&quot;1\&quot; Colaborador : colaborador\n  EntregaEpi \&quot;*\&quot; --&gt; \&quot;1\&quot; Epi : epi\n  Aso \&quot;*\&quot; --&gt; \&quot;1\&quot; Colaborador : colaborador\n  ColaboradorCertificado \&quot;*\&quot; --&gt; \&quot;1\&quot; Colaborador : colaborador\n  ColaboradorCertificado \&quot;*\&quot; --&gt; \&quot;1\&quot; Certificado : certificado\n  OrdemServico \&quot;*\&quot; --&gt; \&quot;1\&quot; Colaborador : colaborador\n  FichaRegistro \&quot;*\&quot; --&gt; \&quot;1\&quot; Colaborador : colaborador&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="nALI3-QMV8bGgLdBHgnx-224">
